OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
ONELEARN_ADMIN_EMAILS=
ONELEARN_DAILY_AI_REQUESTS=40
ONELEARN_DAILY_TOKEN_BUDGET=250000
# Daily AI requests shared by all anonymous (not signed-in) devices behind one IP.
ONELEARN_ANONYMOUS_DAILY_AI_REQUESTS_PER_IP=15
# oai-authenticated-* identity headers are trusted only on ChatGPT Sites.
# Auto-detected (untrusted when VERCEL is set); set true/false to override.
ONELEARN_TRUST_PLATFORM_IDENTITY=

# Vercel only: Clerk sign-in (email code) and Turso database. Leave empty on ChatGPT Sites.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Review reminder emails (Resend) sent by the daily Vercel Cron job in vercel.json.
RESEND_API_KEY=
ONELEARN_EMAIL_FROM=OneLearn <reminders@onelearn.ltd>
# Vercel sends this as a Bearer token to /api/cron/review-reminders.
CRON_SECRET=
# Optional: signs unsubscribe links (defaults to CRON_SECRET).
ONELEARN_EMAIL_SECRET=

# Optional error reporting for API failures.
SENTRY_DSN=

# Stripe Billing. Create recurring CNY prices matching the public plan catalog.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PERSONAL_MONTHLY=
STRIPE_PRICE_PERSONAL_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
ONELEARN_SITE_URL=https://www.onelearn.ltd
